# Local development settings. Copy to .env (git-ignored) and load it in the
# run target, for example with `dotenv: ['.env']` in the Taskfile.
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

# Required.
DATABASE_DSN=postgres://workflow:workflow@localhost:5432/workflow?sslmode=disable
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# The services workflow calls.
IDENTITY_GRPC_ADDR=localhost:9091
CORE_GRPC_ADDR=localhost:9090

# Ports: gRPC, and plain HTTP for /livez and /readyz.
GRPC_PORT=9092
PROBE_PORT=8080

# A stage's SLA and reminder when the stage sets none.
STAGE_SLA_HOURS=72
STAGE_REMINDER_HOURS=48

# Optional: a separate database for the saga engine's tables, and mTLS
# (transport only).
SAGA_DATABASE_DSN=
GRPC_TLS_CERT_FILE=
GRPC_TLS_KEY_FILE=
GRPC_TLS_CLIENT_CA_FILE=

# Service-to-service authentication. Local runs switch it off; readiness then
# reports workloadauth degraded. In a cluster, drop WORKLOAD_AUTH and set the
# issuer, CA file, bearer file and allow-list instead (never both).
WORKLOAD_AUTH=disabled
# WORKLOAD_OIDC_ISSUER=https://kubernetes.default.svc.cluster.local
# WORKLOAD_OIDC_CA_FILE=/var/run/secrets/steward/kube-ca/ca.crt
# WORKLOAD_OIDC_BEARER_FILE=/var/run/secrets/steward/jwks/token
# WORKLOAD_ALLOWED_SERVICEACCOUNTS=steward/steward-gateway
# Workflow's own token, sent to core and identity. Unset with auth disabled
# sends none.
# WORKLOAD_TOKEN_FILE=/var/run/secrets/steward/token
